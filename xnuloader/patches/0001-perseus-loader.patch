+/*
+ * The same, with the kernel's log as it stands: what a session that ends with a manual reboot
+ * must leave behind. (Until now only the loader's own log went out during a run.)
+ */
+static void
+flush_log_live(const struct kernel_live *live, uint64_t slide)
+{
+	efi_block_io *bio;
+
+	if (live == NULL) {
+		flush_log();
+		return;
+	}
+	compose_live_log(live, slide);
+	bio = find_log_partition();
+	if (bio != NULL) {
+		write_staged(bio);
+	}
+}
